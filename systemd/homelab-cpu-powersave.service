[Unit]
Description=Apply homelab CPU powersave governor
After=multi-user.target
ConditionPathExists=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo powersave > "$f"; done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
