              "type": "auto"
            },
            "inspect": false
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "title": "Presence / Security",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "hass_binary_sensor_state{entity=~\".*(occupancy|motion|door|window|presence|fp2|aquara).*\"}",
          "instant": false,
          "legendFormat": "{{friendly_name}}",
          "range": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": false
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "off"
                },
                "1": {
                  "text": "on"
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      }
    },
