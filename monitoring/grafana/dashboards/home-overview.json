  "panels": [
    {
      "id": 8,
      "title": "HA Entities",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(hass_entity_available)",
          "instant": false,
          "legendFormat": "exported",
          "range": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "title": "Home Temperature (F)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "label_replace(((hass_temperature_c{entity=\"sensor.switchbot_hub_temperature\",entity=~\"$ha_entity\"} * 9 / 5) + 32), \"display_name\", \"Office\", \"entity\", \".*\") or label_replace(((hass_temperature_c{entity=\"sensor.downstairs_temperature\",entity=~\"$ha_entity\"} * 9 / 5) + 32), \"display_name\", \"Downstairs\", \"entity\", \".*\") or label_replace(((hass_temperature_c{entity!=\"sensor.inovelli_dimmer_switch_internal_temperature\",entity!~\"sensor.switchbot_hub_temperature|sensor.downstairs_temperature\",entity=~\"$ha_entity\"} * 9 / 5) + 32), \"display_name\", \"$1\", \"friendly_name\", \"(.*)\")",
          "instant": false,
          "legendFormat": "{{display_name}}",
          "range": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "fahrenheit"
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "title": "Home Humidity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "hass_humidity_percent{entity=~\"$ha_entity\"}",
          "instant": false,
          "legendFormat": "{{friendly_name}}",
          "range": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "title": "Low Batteries",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sort(hass_battery_percent{entity=~\"$ha_entity\"})",
          "instant": true,
          "legendFormat": "{{friendly_name}}",
          "range": false,
          "refId": "A",
          "format": "table"
        }
