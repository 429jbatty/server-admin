            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
