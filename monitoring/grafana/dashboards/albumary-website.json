    {
      "id": 19,
      "title": "How to read this dashboard",
      "type": "text",
      "description": "Quick guide to the Albumary website metrics.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Availability** is the independent 60-second HTTPS probe. **Blue values are informational**, not warnings. Cloudflare traffic figures are **rolling 24-hour totals** refreshed about every five minutes, so each chart point summarizes the 24 hours before that point. Page views/visitors come from browser Web Analytics; HTTP requests/transfer include pages, assets, APIs, and bots. Hover the **info icon** beside any panel title for its exact meaning."
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "pluginVersion": "13.0.1"
    },
    {
      "id": 1,
      "title": "Site Up",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "probe_success{job=\"blackbox-albumary\",instance=\"https://app.albumary.net\"}",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "NO DATA",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "description": "Independent HTTPS probe from CT 108. UP means app.albumary.net returned HTTP 200 on the latest 60-second check."
    },
    {
      "id": 2,
